# ==============================================================
# Supabase
# ==============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ==============================================================
# ByMe Free Tier — Platform's Gemini Flash key
# This key powers the free tier for all users.
# Get yours at: https://aistudio.google.com/
# ==============================================================
BYME_GEMINI_API_KEY=AIza...

# ==============================================================
# LLM Provider Keys (for BYOK validation — optional at backend level)
# These are NOT used for generation; users bring their own keys.
# You can leave these blank unless you want server-side validation.
# ==============================================================
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...

# ==============================================================
# Security
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ==============================================================
ENCRYPTION_KEY=your-fernet-key-here

# ==============================================================
# App Config
# ==============================================================
ALLOWED_ORIGINS=http://localhost:3005,https://your-byme-app.vercel.app
ENVIRONMENT=development

# Free tier monthly limit per user
FREE_TIER_MONTHLY_LIMIT=10
