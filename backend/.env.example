# ==============================================================
# Supabase  (all REQUIRED — server refuses to boot without them)
# ==============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ==============================================================
# Free tier — powered by OpenRouter (REQUIRED)
# This key powers the "Try ByMe" trial for all free users.
# Get one at: https://openrouter.ai/keys
# ==============================================================
OPENROUTER_API_KEY=sk-or-...

# The free-tier model. MUST be a genuinely free model id (note the :free suffix)
# or you will be billed for every trial generation.
FREE_TIER_MODEL=google/gemini-2.0-flash-exp:free

# ==============================================================
# LLM Provider Keys (optional fallbacks for BYOK / local dev)
# Not used for generation; users bring their own keys.
# ==============================================================
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...

# ==============================================================
# Security  (REQUIRED — must be a valid Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: changing this makes all stored BYOK keys undecryptable.
# ==============================================================
ENCRYPTION_KEY=your-fernet-key-here

# ==============================================================
# App Config
# ==============================================================
# Comma-separated allowed frontend origins. In production the localhost
# regex is disabled, so this MUST include your real frontend URL.
ALLOWED_ORIGINS=http://localhost:5175,https://your-byme-app.vercel.app
ENVIRONMENT=development

# Free tier monthly post limit per user
FREE_TIER_MONTHLY_LIMIT=10

# Max upload size for LinkedIn archive / analytics files (bytes). Default 15 MB.
MAX_UPLOAD_BYTES=15728640
